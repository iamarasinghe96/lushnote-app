{
  "name": "lushnote",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project lush-note-rules-test \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "docx": "^9.7.1",
    "firebase": "^10.0.0",
    "firebase-admin": "^14.0.0",
    "jspdf": "^2.5.1",
    "next": "14.2.x",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "~1.56.1",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "firebase-tools": "^15.28.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "comments": {
    "overrides": "firebase-admin -> jwks-rsa does require('jose'), but jose@6 is ESM-only (no CommonJS require export) and crashes with ERR_REQUIRE_ESM on Vercel's Node runtime. Pin jose to v5, which ships a CommonJS build. jwks-rsa only uses importJWK/exportSPKI, unchanged between v5 and v6."
  },
  "overrides": {
    "jose": "5.10.0"
  }
}
